{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "projeto-duimp",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  // Aponta direto pro bundle já compilado pelo `vite build` (dist/server/server.js),
  // não pra fonte TS crua (src/server.ts) — o plugin @cloudflare/vite-plugin resolve
  // os módulos virtuais do TanStack Start (#tanstack-router-entry etc.) só durante o
  // build do Vite; o esbuild do wrangler sozinho não sabe resolvê-los.
  //
  // Deixamos o wrangler empacotar normalmente (sem no_bundle) — o output do vite
  // ainda depende de um alias interno do TanStack Start (import "h3-v2", mapeado via
  // "imports" no package.json dele pro pacote real h3@2). O esbuild do wrangler
  // resolve esse alias certinho a partir do node_modules; em modo no_bundle isso
  // fica como um import externo sem runtime pra resolver e quebra em produção.
  "main": "dist/server/server.js",
  "assets": {
    "directory": "dist/client",
  },
  // Garante que o `vite build` sempre roda antes do wrangler empacotar/validar,
  // tanto localmente (`bun run deploy`) quanto na CI da Cloudflare (Workers Builds),
  // que chama `wrangler deploy` direto sem passar por um script de build separado.
  "build": {
    "command": "bun run build",
  },
}
